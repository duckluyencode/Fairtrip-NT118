{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTripFairSettings",
      "Effect": "Allow",
      "Action": ["ssm:GetParametersByPath", "ssm:GetParameters", "ssm:GetParameter"],
      "Resource": [
        "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/tripfair/prod",
        "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/tripfair/prod/*"
      ]
    },
    {
      "Sid": "DecryptSettingsThroughSsmOnly",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.REGION.amazonaws.com" } }
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PullTripFairImages",
      "Effect": "Allow",
      "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer", "ecr:BatchCheckLayerAvailability"],
      "Resource": [
        "arn:aws:ecr:REGION:ACCOUNT_ID:repository/tripfair-api",
        "arn:aws:ecr:REGION:ACCOUNT_ID:repository/tripfair-migrate"
      ]
    }
  ]
}
