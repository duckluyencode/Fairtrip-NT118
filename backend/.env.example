# Copy this file to .env and replace the placeholder passwords. Never commit .env.

# API server
PORT=3000

# Local MySQL started by docker compose
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=tripfair
MYSQL_USER=tripfair
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# Needed for the local Docker database (no TLS). Set to false for RDS over TLS.
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# Used by the Prisma CLI (migrations); must match the values above
DATABASE_URL=mysql://tripfair:change-me@localhost:3306/tripfair
# Scratch database for `prisma migrate dev`, created by docker/mysql-init
SHADOW_DATABASE_URL=mysql://tripfair:change-me@localhost:3306/tripfair_shadow

# Auth: signs access and password-reset tokens and hashes OTP codes.
# At least 32 characters; generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string

# Email OTP over SMTP. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, your Gmail address
# and an App Password (Google Account > Security > 2-Step Verification > App passwords).
# Leave SMTP_HOST empty to print codes in the server log instead (development only).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to users; defaults to SMTP_USER
SMTP_FROM=

# Optional: Google Cloud key for Places API (New), Routes API and Cloud Vision API (real place
# data, driving times, photo recognition). Without it the sample catalog is used (development
# only) and photo recognition is unavailable. Restrict the key to those three APIs and set daily
# quotas: see docs/google-cloud.md.
GOOGLE_MAPS_API_KEY=
