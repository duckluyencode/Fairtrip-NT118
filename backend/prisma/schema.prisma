// Prisma schema for the TripFair backend.
// Tables are added module by module; the full design is in docs/database.md.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Explicit, so the output does not depend on whether tsconfig.json is present
  // (it is not yet when `npm ci` runs `prisma generate` in the Docker build).
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

/// A TripFair account. Signs in with email or phone; the database requires at least one.
model User {
  id                Int       @id @default(autoincrement())
  email             String?   @unique @db.VarChar(254)
  /// E.164 format, e.g. +84905128846.
  phone             String?   @unique @db.VarChar(16)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  fullName          String    @map("full_name") @db.VarChar(100)
  avatarUrl         String?   @map("avatar_url") @db.VarChar(2048)
  /// Set when the sign-up code is confirmed; null means the account cannot sign in yet.
  verifiedAt        DateTime? @map("verified_at")
  /// Password reset tokens issued before this time are no longer accepted.
  passwordChangedAt DateTime? @map("password_changed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  otpCodes      OtpCode[]
  refreshTokens RefreshToken[]
  searchHistory SearchHistory[]
  favorites     Favorite[]
  ownedTrips    Trip[]
  memberships   TripMember[]

  @@map("users")
}

enum PlaceSource {
  /// TripFair's own data (sample catalog until partner data arrives).
  CATALOG
  /// Found through Google Places; only the place ID is stored, details are fetched live.
  GOOGLE
}

/// Filters in the app: Ăn uống, Vui chơi, Cảnh đẹp.
enum PlaceCategory {
  FOOD
  FUN
  SCENIC
}

enum PriceSource {
  PARTNER_API
  GOOGLE_API
  ESTIMATED
}

/// A place. CATALOG rows hold all their data (a CHECK constraint requires it);
/// GOOGLE rows hold only the Google place ID, as the Google Maps terms allow.
model Place {
  id             Int            @id @default(autoincrement())
  source         PlaceSource    @default(CATALOG)
  /// Stable key of catalog places, e.g. "golden-bridge".
  slug           String?        @unique @db.VarChar(100)
  googlePlaceId  String?        @unique @map("google_place_id") @db.VarChar(255)
  name           String?        @db.VarChar(200)
  /// Line under the name, e.g. "Bà Nà Hills · Hòa Vang".
  area           String?        @db.VarChar(200)
  city           String?        @db.VarChar(100)
  /// Main category, shown as the label.
  category       PlaceCategory?
  lat            Float?
  lng            Float?
  rating         Float?
  ratingCount    Int?           @map("rating_count")
  /// Minutes after midnight; both null means open all day. close < open means after midnight.
  openMinute     Int?           @map("open_minute")
  closeMinute    Int?           @map("close_minute")
  description    String?        @db.Text
  imageUrl       String?        @map("image_url") @db.VarChar(2048)
  visitMinutes   Int?           @map("visit_minutes")
  /// VND per person; equal when the price is fixed, 0 when free. Null when included in the parent's ticket.
  priceMin       Int?           @map("price_min")
  priceMax       Int?           @map("price_max")
  priceSource    PriceSource?   @map("price_source")
  priceProvider  String?        @map("price_provider") @db.VarChar(100)
  priceUpdatedAt DateTime?      @map("price_updated_at")
  /// Ticketed area this place is inside, e.g. Cầu Vàng inside Bà Nà Hills.
  parentId       Int?           @map("parent_id")
  /// Name, area and city lowercased without diacritics, for search.
  searchText     String?        @map("search_text") @db.VarChar(600)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  parent      Place?              @relation("PlaceParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    Place[]             @relation("PlaceParent")
  categories  PlaceCategoryLink[]
  favorites   Favorite[]
  interests   PlaceInterest[]
  tripStops   TripStop[]
  voteOptions VoteOption[]
  lodgings    TripLodging[]

  @@index([source, city])
  @@map("places")
}

/// Every category a place belongs to (including its main one), for filtering.
model PlaceCategoryLink {
  placeId  Int           @map("place_id")
  category PlaceCategory

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([placeId, category])
  @@index([category])
  @@map("place_categories")
}

/// One row per distinct query of a user; searching again moves it to the top.
model SearchHistory {
  id              Int            @id @default(autoincrement())
  userId          Int            @map("user_id")
  /// As the user last typed it.
  query           String         @db.VarChar(100)
  /// Lowercased without diacritics; "Đà Nẵng" and "da nang" are the same entry.
  normalizedQuery String         @map("normalized_query") @db.VarChar(100)
  /// Category filter used with the query, if any.
  category        PlaceCategory?
  searchedAt      DateTime       @default(now()) @map("searched_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedQuery])
  @@index([userId, searchedAt])
  @@map("search_history")
}

model Favorite {
  userId    Int      @map("user_id")
  placeId   Int      @map("place_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([userId, placeId])
  @@index([placeId])
  @@map("favorites")
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
}

/// A 6-digit code sent by email or SMS. Only the latest unused code of a purpose is valid.
model OtpCode {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  purpose     OtpPurpose
  /// Normalized email or E.164 phone the code was sent to.
  destination String     @db.VarChar(254)
  /// HMAC-SHA256 of the code, hex.
  codeHash    String     @map("code_hash") @db.Char(64)
  expiresAt   DateTime   @map("expires_at")
  /// Wrong guesses so far; the code is locked once the limit is reached.
  attempts    Int        @default(0)
  usedAt      DateTime?  @map("used_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("otp_codes")
}

/// Long-lived sign-in token; rotated on every refresh and revoked on logout.
model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  /// SHA-256 of the token, hex. The token itself is only ever sent to the client.
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// The app's 8 travel preferences ("Ẩm thực", "Biển", "Cảnh đẹp"...), used to score places.
enum Interest {
  FOOD
  BEACH
  SCENERY
  RELAX
  FUN
  PHOTO
  CULTURE
  EXPLORE
}

/// Preferences a catalog place suits. Google places get theirs from Google's place types.
model PlaceInterest {
  placeId  Int      @map("place_id")
  interest Interest

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([placeId, interest])
  @@map("place_interests")
}

enum TripType {
  SOLO
  GROUP
}

enum TripStatus {
  /// Collecting members, budgets and votes; no itinerary yet (or it was cleared).
  DRAFT
  PLANNED
}

enum LodgingMode {
  HOTEL
  /// "Tự lo chỗ ở": no room cost, the whole budget goes to places.
  SELF
}

enum TripRole {
  OWNER
  MEMBER
}

/// A trip. A group trip is the group itself (one group plans one trip); a solo trip is a
/// group of one, so both use the same planner.
model Trip {
  id             Int         @id @default(autoincrement())
  ownerId        Int         @map("owner_id")
  type           TripType
  /// Group name, e.g. "Nhóm Đà Nẵng".
  name           String?     @db.VarChar(100)
  city           String      @db.VarChar(100)
  startDate      DateTime    @map("start_date") @db.Date
  endDate        DateTime    @map("end_date") @db.Date
  /// Daily window for visits, minutes after midnight.
  dayStartMinute Int         @default(480) @map("day_start_minute")
  dayEndMinute   Int         @default(1260) @map("day_end_minute")
  /// Minimum pause between two visits ("thời gian giữa các lần đi chơi").
  gapMinutes     Int         @default(30) @map("gap_minutes")
  lodgingMode    LodgingMode @default(SELF) @map("lodging_mode")
  status         TripStatus  @default(DRAFT)
  /// Code friends type to join a group, e.g. DN1214.
  inviteCode     String?     @unique @map("invite_code") @db.VarChar(8)
  voteDeadline   DateTime?   @map("vote_deadline")
  plannedAt      DateTime?   @map("planned_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  owner   User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members TripMember[]
  lodging TripLodging?
  stops   TripStop[]
  options VoteOption[]

  @@index([ownerId])
  @@map("trips")
}

model TripMember {
  id           Int       @id @default(autoincrement())
  tripId       Int       @map("trip_id")
  userId       Int       @map("user_id")
  role         TripRole  @default(MEMBER)
  /// Maximum the member wants to spend, VND. Only the member (and the planner) sees it.
  budget       Int       @default(0)
  /// The member's part of the room cost, set when the trip is planned.
  lodgingShare Int       @default(0) @map("lodging_share")
  /// 0–100 after planning.
  satisfaction Int?
  ballotSentAt DateTime? @map("ballot_sent_at")
  joinedAt     DateTime  @default(now()) @map("joined_at")

  trip         Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests    MemberInterest[]
  stops        StopParticipant[]
  votes        Vote[]
  addedOptions VoteOption[]

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_members")
}

model MemberInterest {
  memberId Int      @map("member_id")
  interest Interest

  member TripMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, interest])
  @@map("member_interests")
}

/// The hotel chosen for a trip. The hotel is a place (found through Google Places, so only
/// its place ID is stored); its nightly price is copied here when it is chosen.
model TripLodging {
  tripId        Int         @id @map("trip_id")
  placeId       Int         @map("place_id")
  checkIn       DateTime    @map("check_in") @db.Date
  checkOut      DateTime    @map("check_out") @db.Date
  rooms         Int
  guestsPerRoom Int         @map("guests_per_room")
  /// VND for one room and one night.
  pricePerNight Int         @map("price_per_night")
  priceSource   PriceSource @map("price_source")
  priceProvider String      @map("price_provider") @db.VarChar(100)
  pricedAt      DateTime    @map("priced_at")

  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id])

  @@index([placeId])
  @@map("trip_lodgings")
}

/// One visit in the itinerary. The price is copied at planning time, so later price
/// changes do not change a plan.
model TripStop {
  id            Int         @id @default(autoincrement())
  tripId        Int         @map("trip_id")
  placeId       Int         @map("place_id")
  day           Int
  position      Int
  startMinute   Int         @map("start_minute")
  travelMinutes Int         @map("travel_minutes")
  visitMinutes  Int         @map("visit_minutes")
  /// Ticket or meal price per person, VND, before ticketed-area coverage.
  costPerPerson Int         @map("cost_per_person")
  priceSource   PriceSource @map("price_source")
  priceProvider String      @map("price_provider") @db.VarChar(100)

  trip         Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place        Place             @relation(fields: [placeId], references: [id])
  participants StopParticipant[]

  @@unique([tripId, day, position])
  @@index([placeId])
  @@map("trip_stops")
}

/// Who goes to a stop and what they pay there (0 when their ticket for the area covers it).
model StopParticipant {
  stopId   Int @map("stop_id")
  memberId Int @map("member_id")
  cost     Int

  stop   TripStop   @relation(fields: [stopId], references: [id], onDelete: Cascade)
  member TripMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([stopId, memberId])
  @@index([memberId])
  @@map("stop_participants")
}

/// A place proposed for the trip. Group members vote on it; a solo trip's picks are
/// options too, so the planner always plans from options when there are any.
model VoteOption {
  id        Int      @id @default(autoincrement())
  tripId    Int      @map("trip_id")
  placeId   Int      @map("place_id")
  addedById Int?     @map("added_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  trip    Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place   Place       @relation(fields: [placeId], references: [id])
  addedBy TripMember? @relation(fields: [addedById], references: [id], onDelete: SetNull)
  votes   Vote[]

  @@unique([tripId, placeId])
  @@index([placeId])
  @@index([addedById])
  @@map("vote_options")
}

/// A member ticking "đồng ý" for an option.
model Vote {
  optionId  Int      @map("option_id")
  memberId  Int      @map("member_id")
  createdAt DateTime @default(now()) @map("created_at")

  option VoteOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  member TripMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([optionId, memberId])
  @@index([memberId])
  @@map("votes")
}
