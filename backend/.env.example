# Copy this file to .env and replace the placeholder passwords. Never commit .env.

# API server
PORT=3000

# Local MySQL started by docker compose
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=tripfair
MYSQL_USER=tripfair
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# Needed for the local Docker database (no TLS). Set to false for RDS over TLS.
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# Used by the Prisma CLI (migrations); must match the values above
DATABASE_URL=mysql://tripfair:change-me@localhost:3306/tripfair
